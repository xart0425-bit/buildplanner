# ─────────────────────────────────────────────────────────────────────────────
# BuildPlanner 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 아무것도 설정하지 않아도 앱은 뜹니다 — DB는 인메모리로, LLM 키는 앱 안의
# [설정] 모달에서 브라우저에 저장해 쓸 수 있습니다.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL 연결 문자열 (선택)
# 비워두면 인메모리 저장소로 동작합니다. 서버를 재시작하면 데이터가 사라집니다.
# DATABASE_URL=mysql://user:password@localhost:3306/build_planner

# ── LLM 제공자 (선택: 앱 [설정] 모달에서 키를 넣으면 여기 없어도 됩니다) ──
# 서버에 키를 두면 모든 사용자가 그 키를 쓰게 되므로, 공개 배포 시에는 비워두고
# 각자 [설정]에 자기 키를 넣게 하는 편이 안전합니다.

# Google Gemini (OpenAI 호환 엔드포인트 사용)
# GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1/chat/completions

# 모델 지정 (미설정 시 키 종류에 따라 gemini-2.5-flash / gpt-4o-mini)
# LLM_MODEL=gemini-2.5-flash

# ── 서버 ──
PORT=3000
NODE_ENV=development

# 세션 쿠키 서명 키. 배포 시 반드시 임의의 긴 문자열로 바꾸세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-deploying

# ── 로컬 폴더 참조 기능 ──
# "프로젝트 폴더 지정" 기능은 서버가 실행 중인 PC의 디스크를 읽고, Windows에서는
# 폴더 선택 창을 띄웁니다. 내 PC에서 혼자 쓰는 도구일 때만 의미가 있는 기능입니다.
#   미설정         → 개발 모드에서만 켜짐 (NODE_ENV=production 이면 자동으로 꺼짐)
#   true           → 항상 켜짐 (공개 서버에서는 절대 사용하지 마세요)
#   false          → 항상 꺼짐
# ALLOW_LOCAL_FS=true

# ── 방문자 구분 ──
# 로그인이 없는 대신, 배포 환경에서는 브라우저마다 게스트 계정을 발급해 서로의
# 리서치가 섞이지 않게 합니다.
#   미설정        → 프로덕션에서만 브라우저별 발급, 로컬은 계정 하나 공유
#   per-browser   → 항상 브라우저별로 분리
#   shared        → 항상 계정 하나 공유
# GUEST_SESSIONS=per-browser
